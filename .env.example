# ── Supabase (Project Settings → API) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key
# JANGAN pernah diberi awalan NEXT_PUBLIC_. Hanya dipakai di server.
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key

# ── Sesi siswa (JWT httpOnly cookie) ───────────────────────────
# Minimal 32 karakter acak. Buat dengan: openssl rand -base64 48
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# ── Google Gemini (AstroBot) ───────────────────────────────────
GEMINI_API_KEY=AIza...
# Model bisa diubah juga lewat Admin → AstroBot
GEMINI_MODEL=gemini-2.5-flash
